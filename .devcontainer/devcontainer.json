{
	"name": "Rintro",
	"image": "ghcr.io/rocker-org/devcontainer/r-ver:4.2",
	"features": {
//		"ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
//			"packages": "cli,rlang,tidyverse,pheatmap,codetools,upsetr,ggridges,ggrepel,ggthemes,kernsmooth",
//			"installSystemRequirements": true
//		},
		"ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
			"installTinyTex": false,
			"version": "prerelease" // to fix problem with preview
		}
	},
	"postCreateCommand": "R -e 'install.packages(c(\"tidyverse\", \"pheatmap\", \"codetools\", \"UpSetR\", \"ggridges\", \"ggrepel\", \"ggthemes\", \"KernSmooth\"), repos=\"https://cloud.r-project.org/\")'",
  
	"customizations": {
		"vscode": {
			"extensions": [
				"quarto.quarto",
				"reditorsupport.r"
			],
			"settings": {
				"r.bracketedPaste": true,
				"editor.formatOnSave": true,
				"editor.tabSize": 2,
				"r.sessionWatcher": true
			  }
		}
	}
}